{
  "schemaVersion": "tpl.binomial.contract.v1",
  "inputSchemaVersion": "tpl.binomial.input.v1",
  "analysisSchemaVersion": "tpl.binomial.analysis.v1",
  "engineVersion": "1.0.0",
  "model": "cox_ross_rubinstein",
  "measure": "risk_neutral_Q",
  "dayCounts": ["ACT/365F"],
  "optionTypes": ["call", "put"],
  "exerciseStyles": ["european", "american"],
  "positions": ["long", "short"],
  "limits": {
    "maxInputBytes": 1000000,
    "minSpot": 1e-8,
    "maxSpot": 1000000000000,
    "minStrike": 1e-8,
    "maxStrike": 1000000000000,
    "minVolatility": 0,
    "maxVolatility": 5,
    "minMaturityYears": 0,
    "maxMaturityYears": 30,
    "minRate": -1,
    "maxRate": 1,
    "minSteps": 2,
    "maxSteps": 2000,
    "maxDisplayDepth": 6,
    "maxQuantity": 1000000,
    "minContractMultiplier": 1e-8,
    "maxContractMultiplier": 1000000000000
  },
  "numeric": {
    "exerciseTolerance": 1e-12,
    "probabilityTolerance": 1e-14,
    "exportSignificantDigits": 9,
    "hashSignificantDigits": 17
  },
  "conventions": {
    "up": "exp(volatility * sqrt(dt))",
    "down": "1 / up",
    "probability": "(exp((risk_free_rate-dividend_yield)*dt)-down)/(up-down)",
    "discount": "exp(-risk_free_rate*dt)",
    "americanExercise": "max(intrinsic, discounted_risk_neutral_continuation)",
    "earlyExercisePremium": "american_price_minus_european_price",
    "zeroVolatility": "deterministic risk-neutral path with backward optimal stopping",
    "atExpiry": "exact intrinsic value",
    "vega": "price change per +1 volatility percentage point",
    "rho": "price change per +1 rate percentage point",
    "theta": "price change for one calendar day elapsed"
  },
  "exports": {
    "convergenceCsvSchema": "tpl.binomial.convergence.v1",
    "frontierCsvSchema": "tpl.binomial.frontier.v1",
    "convergenceCsvHeaders": ["schemaVersion", "engineVersion", "analysisId", "exerciseStyle", "optionType", "steps", "pricePerUnit", "europeanPricePerUnit", "blackScholesBenchmark", "absoluteBenchmarkError"],
    "frontierCsvHeaders": ["schemaVersion", "engineVersion", "analysisId", "optionType", "step", "timeYears", "boundarySpot", "exerciseNodeCount"],
    "lineEnding": "LF",
    "finalNewline": true,
    "numericFormat": "finite_significant_9"
  }
}
