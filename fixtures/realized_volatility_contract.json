{
  "contractVersion": "1.0.0",
  "resultSchema": "tpl.realized-volatility-analysis.v1",
  "rollingCsvSchema": "tpl.realized-volatility.rolling.v1",
  "observationsCsvSchema": "tpl.realized-volatility.observations.v1",
  "csv": {
    "requiredHeader": ["date", "open", "high", "low", "close"],
    "optionalTrailingHeader": "volume",
    "delimiters": [",", ";"],
    "maxUtf8Bytes": 10485760,
    "maxRows": 50001,
    "blankRows": "reject",
    "headerOrder": "exact",
    "dateOrder": "strictly_increasing",
    "dateMinimum": "1900-01-01",
    "dateMaximum": "2200-12-31",
    "numberFormat": "finite_dot_decimal_no_thousands_separator"
  },
  "config": {
    "windowMinimum": 5,
    "windowMaximum": 252,
    "annualizationMinimum": 1,
    "annualizationMaximum": 366,
    "calendarModes": ["weekday_sessions", "calendar_daily"],
    "priceBases": ["unadjusted_ohlc", "split_adjusted_ohlc", "provider_adjusted_ohlc", "unknown"]
  },
  "diagnostics": {
    "largeMoveAbsoluteLogThreshold": 0.22314355131420976,
    "robustReturnZThreshold": 8.0,
    "flatAndRepeatedFractionThreshold": 0.05,
    "estimatorDivergenceRatioThreshold": 1.5,
    "overnightDominanceThreshold": 0.5
  },
  "provenance": {
    "datasetHash": "sha256_utf8_canonical_csv",
    "canonicalCsvHeaderOrder": ["date", "open", "high", "low", "close", "volume"],
    "canonicalCsvLineEnding": "LF",
    "canonicalCsvFinalNewline": true,
    "canonicalNumericSignificantDigits": 17,
    "canonicalNumericFormat": "normalized_scientific",
    "rawUploadHashForbidden": true
  },
  "exportNumericSignificantDigits": 12,
  "exportNumericFormat": "normalized_scientific",
  "resultRequiredKeys": [
    "schema",
    "engineVersion",
    "analysisId",
    "source",
    "provenance",
    "config",
    "conventions",
    "limitations",
    "inputs",
    "dateRange",
    "observationCount",
    "sessionCount",
    "yangZhangK",
    "summary",
    "estimators",
    "rolling",
    "observations",
    "warnings",
    "diagnostics"
  ],
  "rollingCsvHeaders": [
    "schema",
    "engineVersion",
    "sourceSha256",
    "annualization",
    "windowSessions",
    "startDate",
    "endDate",
    "closeToCloseVariance",
    "closeToCloseAnnualizedVolatility",
    "parkinsonVariance",
    "parkinsonAnnualizedVolatility",
    "garmanKlassVariance",
    "garmanKlassAnnualizedVolatility",
    "rogersSatchellVariance",
    "rogersSatchellAnnualizedVolatility",
    "yangZhangVariance",
    "yangZhangAnnualizedVolatility"
  ],
  "observationsCsvHeaders": [
    "schema",
    "engineVersion",
    "sourceSha256",
    "date",
    "open",
    "high",
    "low",
    "close",
    "volume",
    "closeToCloseReturn",
    "overnightReturn",
    "openToCloseReturn",
    "logRange",
    "flags",
    "closeToCloseVarianceContribution",
    "parkinsonVarianceContribution",
    "garmanKlassVarianceContribution",
    "rogersSatchellVarianceContribution",
    "yangZhangVarianceContribution"
  ]
}
