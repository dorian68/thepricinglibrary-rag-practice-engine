TPL_DATA_DIR=./data
TPL_DB_PATH=./data/pricinglibrary_rag.sqlite3
TPL_EMBEDDING_BACKEND=local-hashing
TPL_EMBEDDING_DIM=2048
TPL_LLM_PROVIDER=openai
TPL_OPENAI_MODEL=gpt-4o-mini
# TPL_OPENAI_API_KEY=sk-...
# OPENAI_API_KEY=sk-...

# Optional local-only providers.
# TPL_SENTENCE_TRANSFORMER_MODEL=C:/models/bge-small-en-v1.5
# TPL_LLM_PROVIDER=ollama
# TPL_OLLAMA_URL=http://localhost:11434
# TPL_OLLAMA_MODEL=llama3.1:8b
# TPL_LLM_PROVIDER=transformers
# TPL_TRANSFORMERS_MODEL_PATH=C:/models/local-instruct-model

# --- Billing (Stripe) --------------------------------------------------
# Leave unset to run in offline "mock" mode (no charge; /billing/checkout
# returns a mock session and the UI shows an honest "not configured" notice).
# Use TEST keys (sk_test_..., price ids from the Stripe test dashboard).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...          # from `stripe listen` or the dashboard
# STRIPE_PRICE_STARTER=price_...           # 9€/mo
# STRIPE_PRICE_STUDENT=price_...           # 19€/mo
# STRIPE_PRICE_PRO=price_...               # 49€/mo
# TPL_BILLING_CHECKOUT_MODE=subscription   # subscription | payment (match price type)
# TPL_BILLING_SUCCESS_URL=http://localhost:5173/billing/success?session_id={CHECKOUT_SESSION_ID}
# TPL_BILLING_CANCEL_URL=http://localhost:5173/pricing
