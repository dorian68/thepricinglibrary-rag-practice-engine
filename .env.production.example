# Copy to a server-only .env.production file. Never commit the populated file.
TPL_IMAGE_REPOSITORY=registry.example.invalid/thepricinglibrary/backend
TPL_IMAGE_DIGEST=replace-with-64-hex-release-image-digest
TPL_PUBLIC_ORIGIN=https://replace-with-public-domain.example
TPL_STARTER_KIT_RELEASE_DIR=/srv/thepricinglibrary/releases/starter-kit/replace-with-version
TPL_STARTER_KIT_BUNDLE_FILENAME=starter-kit-vREPLACE.zip

TPL_API_KEY=replace-with-random-member-key-at-least-32-characters
TPL_OPERATOR_API_KEY=replace-with-different-random-operator-key-at-least-32-characters
TPL_AUTH_ISSUER=https://replace-with-project-ref.supabase.co/auth/v1
TPL_AUTH_AUDIENCE=authenticated
TPL_AUTH_JWKS_URL=https://replace-with-project-ref.supabase.co/auth/v1/.well-known/jwks.json
TPL_AUTH_ALGORITHMS=ES256,RS256
TPL_RATE_LIMIT_PER_MIN=60
TPL_RATE_LIMIT_WINDOW_SECONDS=60
TPL_TRUST_PROXY_HEADERS=false
TPL_CORS_ORIGINS=https://replace-with-public-domain.example

STRIPE_SECRET_KEY=replace-with-live-or-test-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-webhook-signing-secret
STRIPE_PRICE_STARTER=replace-with-starter-price-id
STRIPE_PRICE_STUDENT=replace-with-student-price-id
STRIPE_PRICE_PRO=replace-with-pro-price-id
STRIPE_PRICE_STARTER_KIT=replace-with-one-shot-starter-kit-price-id

TPL_LLM_PROVIDER=template
GENERATION_MODE=template
RETRIEVAL_MODE=hybrid
EMBEDDING_PROVIDER=local
GENERATION_STRICT_VALIDATION=true
TPL_SOURCE_RIGHTS_CLEARED=false
